<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Xkb.Tests</RootNamespace>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- A private package cache: the nupkg keeps its version between rebuilds, so the
         global cache would hand back a stale copy. eng/test-natives.sh clears it. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../artifacts/test-packages/</RestorePackagesPath>
    <XkbPackageVersion>$(Version)</XkbPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xkbcommon-dotnet" Version="$(XkbPackageVersion)" />
    <PackageReference Include="xunit.v3" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../Xkb.NET.Tests/*.cs" Link="Tests/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)TestRunner.cs" Link="TestRunner.cs" />
  </ItemGroup>
</Project>
